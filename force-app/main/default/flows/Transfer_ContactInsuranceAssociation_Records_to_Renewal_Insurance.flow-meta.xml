<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Re-point the member at the renewal policy and restamp the coverage dates from the new term. The record is added to a separate collection because edits made to a loop variable do not reach the source collection.</description>
        <name>Move_it_to_the_New_Term</name>
        <label>Move it to the New Term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Each_ContactInsuranceAssociation.Insurance__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varRenewalInsuranceId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Each_ContactInsuranceAssociation.Coverage_Start_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCoverageStartDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Each_ContactInsuranceAssociation.Coverage_End_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCoverageEndDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRecordsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Each_ContactInsuranceAssociation</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_ContactInsuranceAssociation</targetReference>
        </connector>
    </assignments>
    <description>2026-08-08: Moves the active members of a policy onto its future-dated renewal when that renewal is activated. A renewal whose term starts in the future is created Draft with no coverage of its own, so when someone sets it to Active the source policy&apos;s active ContactInsuranceAssociation records are re-pointed at it and their Coverage Start/End dates restamped from the new term. Existing records are updated, never duplicated. Called by Insurance_Record_Triggered_Orchestration.</description>
    <environments>Default</environments>
    <interviewLabel>Transfer ContactInsuranceAssociation Records to Renewal Insurance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Transfer ContactInsuranceAssociation Records to Renewal Insurance</label>
    <loops>
        <name>Each_ContactInsuranceAssociation</name>
        <label>Each ContactInsuranceAssociation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Active_ContactInsuranceAssociation_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Move_it_to_the_New_Term</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_the_ContactInsuranceAssociation_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Only the members still covered on the source policy move across. Members offboarded mid-term are already inactive and stay where they are. An empty result simply skips the loop and the update runs on an empty collection, so the flow is a safe no-op.</description>
        <name>Get_Active_ContactInsuranceAssociation_Records</name>
        <label>Get Active ContactInsuranceAssociation Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Each_ContactInsuranceAssociation</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_the_Get_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Insurance__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varSourceInsuranceId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContactInsuranceAssociation__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Insurance__c</queriedFields>
        <queriedFields>Active__c</queriedFields>
        <queriedFields>Coverage_Start_Date__c</queriedFields>
        <queriedFields>Coverage_End_Date__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_the_ContactInsuranceAssociation_Records</name>
        <label>Update the ContactInsuranceAssociation Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_the_Error</targetReference>
        </faultConnector>
        <inputReference>varRecordsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Active_ContactInsuranceAssociation_Records</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Log_the_Error</name>
        <label>Log the Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Log_Error</flowName>
        <inputAssignments>
            <name>varContext</name>
            <value>
                <stringValue>Failed to move the ContactInsuranceAssociation records onto the renewal Insurance when the renewal was activated.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varRecordId</name>
            <value>
                <elementReference>varRenewalInsuranceId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSeverity</name>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSourceFlow</name>
            <value>
                <stringValue>Transfer_ContactInsuranceAssociation_Records_to_Renewal_Insurance</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSourceStep</name>
            <value>
                <stringValue>Update_the_ContactInsuranceAssociation_Records</stringValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Log_the_Get_Error</name>
        <label>Log the Get Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Log_Error</flowName>
        <inputAssignments>
            <name>varContext</name>
            <value>
                <stringValue>Failed to query the source policy&apos;s ContactInsuranceAssociation records when the renewal was activated.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varRecordId</name>
            <value>
                <elementReference>varRenewalInsuranceId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSeverity</name>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSourceFlow</name>
            <value>
                <stringValue>Transfer_ContactInsuranceAssociation_Records_to_Renewal_Insurance</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSourceStep</name>
            <value>
                <stringValue>Get_Active_ContactInsuranceAssociation_Records</stringValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <description>End of the renewal term, stamped onto every member that moves across.</description>
        <name>varCoverageEndDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Start of the renewal term, stamped onto every member that moves across.</description>
        <name>varCoverageStartDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varRecordsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContactInsuranceAssociation__c</objectType>
    </variables>
    <variables>
        <description>The renewal policy that has just been activated — the members move onto this one.</description>
        <name>varRenewalInsuranceId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The policy the renewal came from (Parent Insurance) — the members move off this one.</description>
        <name>varSourceInsuranceId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
